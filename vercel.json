{
  "version": 2,
  "builds": [
    { "src": "api/serve.js", "use": "@vercel/node" },
    { "src": "api/landing.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/serve.js", "dest": "api/serve.js" },
    { "src": "/dt-logo.png", "dest": "/public/dt-logo.png" },
    { "src": "/(.*)", "dest": "api/landing.js" }
  ]
}
